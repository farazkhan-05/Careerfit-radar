# Base URL of the CareerFit Radar backend API.
# Leave empty in local development to use the Vite /api proxy.
# In the frontend container, leave empty and set BACKEND_URL for nginx proxying.
VITE_API_URL=

# Optional for local/private deployments. Must match backend API_AUTH_TOKEN.
# Do not rely on this as a secret in a public browser bundle.
VITE_API_AUTH_TOKEN=
