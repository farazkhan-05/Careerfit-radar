APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql://user:password@host:5432/careerfit_radar?sslmode=require

# Required in production. Send as Authorization: Bearer <token> or X-API-Key.
API_AUTH_TOKEN=change-this-to-a-very-long-random-token-32plus

GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_LLM_MODEL=gemini-3.1-flash-lite
EMBEDDING_DIMENSIONS=

MAX_UPLOAD_BYTES=10485760

TAVILY_API_KEY=your_tavily_api_key_here

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
